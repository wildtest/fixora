{
  "name": "fixora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.test node_modules/vitest/vitest.mjs run --project integration",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate:dev": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate deploy",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e:install": "node node_modules/@playwright/test/cli.js install chromium",
    "test:e2e": "npm run build && node --env-file-if-exists=.env.test node_modules/@playwright/test/cli.js test",
    "test:trace": "node scripts/check-traceability.ts",
    "ci:secrets": "node scripts/check-secrets.ts",
    "ci:audit": "node scripts/audit-policy.ts",
    "ci:warm": "node scripts/warm-neon.ts",
    "test:smoke": "node node_modules/@playwright/test/cli.js test --config playwright.smoke.config.ts",
    "ops:privileges": "node --env-file-if-exists=.env.local scripts/verify-runtime-privileges.ts",
    "ops:migration-identity": "node scripts/migration-identity.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module"
}
